# Server
PORT=8080
ENV=development

# Postgres (local: docker-compose / hosted: Neon)
DATABASE_URL=postgres://martech:martech@localhost:5433/martech?sslmode=disable

# Redis (local: docker-compose / hosted: Upstash)
REDIS_URL=redis://localhost:6379/0

# Worker
WORKER_CONSUMER_GROUP=event-workers
WORKER_BATCH_SIZE=100
WORKER_MAX_ATTEMPTS=5
WORKER_CLAIM_IDLE_MS=30000
WORKER_CONCURRENCY=8

# Postgres pool / query bounds
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT_MS=10000

# LLM providers (free tiers) — Groq primary, Gemini backup
LLM_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000

# Rate limiting
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000

# Demo deploys: run worker loop inside the api process (single-service free tier)
RUN_EMBEDDED_WORKER=false

# Logging — stdout JSON lines (LOG_FORMAT=text for local reading)
LOG_LEVEL=info
LOG_FORMAT=json
# Queryable event log (GET /api/v1/logs): all | errors | off
EVENT_LOG_MODE=all
EVENT_LOG_RETENTION_DAYS=7
# Activity log of every API operation (GET /api/v1/activity, UI Logs tab)
ACTIVITY_LOG_ENABLED=true
