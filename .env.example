# Server
PORT=8080
ENV=development

# Postgres (local: docker-compose / hosted: Neon)
DATABASE_URL=postgres://martech:martech@localhost:5432/martech?sslmode=disable

# Redis (local: docker-compose / hosted: Upstash)
REDIS_URL=redis://localhost:6379/0

# Worker
WORKER_CONSUMER_GROUP=event-workers
WORKER_BATCH_SIZE=100
WORKER_MAX_ATTEMPTS=5
WORKER_CLAIM_IDLE_MS=30000

# LLM providers (free tiers) — Groq primary, Gemini backup
LLM_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000

# Rate limiting
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000
